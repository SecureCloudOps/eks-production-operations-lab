{
  "before": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Action": "s3:*",
        "Effect": "Allow",
        "Resource": [
          "arn:aws:s3:::lab04-fixture-bucket",
          "arn:aws:s3:::lab04-fixture-bucket/*"
        ],
        "Sid": "IntentionalLabMisconfiguration"
      }
    ]
  },
  "after": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Action": [
          "s3:ListBucket"
        ],
        "Condition": {
          "StringLike": {
            "s3:prefix": [
              "public/",
              "public/*"
            ]
          }
        },
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::lab04-fixture-bucket",
        "Sid": "ListApplicationPrefix"
      },
      {
        "Action": [
          "s3:GetObject"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::lab04-fixture-bucket/public/*",
        "Sid": "ReadApplicationObjects"
      }
    ]
  }
}
