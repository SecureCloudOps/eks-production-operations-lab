{
  "role": "arn:aws:iam::account-1:role/lab04-role",
  "trust": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::account-1:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/oidc-provider-1"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "oidc.eks.us-east-1.amazonaws.com/id/oidc-provider-1:aud": "sts.amazonaws.com",
            "oidc.eks.us-east-1.amazonaws.com/id/oidc-provider-1:sub": "system:serviceaccount:lab04:public-web"
          }
        }
      }
    ]
  },
