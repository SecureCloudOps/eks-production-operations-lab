    "IncludeGlobalServiceEvents": false,
    "IsMultiRegionTrail": false,
    "TrailARN": "arn:aws:cloudtrail:us-east-1:account-1:trail/lab04-trail",
    "LogFileValidationEnabled": true,
    "IsOrganizationTrail": false
  },
  "initial_status": {
